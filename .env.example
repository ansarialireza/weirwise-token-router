# Weirwise Token Router Environment Template (.env.example)

ENVIRONMENT=development
HOST=0.0.0.0
PORT=8080

# Database Configuration (PostgreSQL 16 recommended)
DATABASE_URL=postgresql+asyncpg://token_router:token_router_pass@127.0.0.1:5432/token_router_db
POSTGRES_USER=token_router
POSTGRES_PASSWORD=your_secure_db_password_here
POSTGRES_DB=token_router_db

# Security & Encryption (REQUIRED in production, minimum 32 chars entropy)
# Generate with: openssl rand -base64 32
VAULT_MASTER_KEY=generate_with_openssl_rand_base64_32_characters_here

# Master Administration API Key (REQUIRED in production, minimum 24 chars entropy)
# Generate with: openssl rand -hex 24
ADMIN_API_KEY=generate_with_openssl_rand_hex_24_characters_here

# Optional Redis for distributed state
REDIS_URL=
